# Bu dosyayı .env adıyla kopyalayıp doldurun (yerel geliştirme için).
# Canlıda aynı değişkenleri Vercel > Project > Settings > Environment Variables bölümüne girin.

# Sitenin tam adresi (sonunda / olmadan). iyzico dönüş adresi ve e-postalardaki bağlantılar için gerekli.
APP_URL=http://localhost:3000

# Supabase > Project Settings > Database > Connection string
# Uygulama için "Transaction pooler" (6543 portlu) adresi:
DATABASE_URL=postgresql://postgres.xxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Kurulum/göç için "Session pooler" (5432 portlu) adresi (isteğe bağlı, yoksa DATABASE_URL kullanılır):
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# (İsteğe bağlı) Supabase > Project Settings > API: Project URL ve secret (service_role) anahtar.
# Girilirse ürün fotoğrafları Supabase Storage'a, girilmezse veritabanına kaydedilir.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=urunler

# iyzico (şirket gerekir). Test için: https://sandbox-merchant.iyzipay.com (anahtarlar "sandbox-" ile başlar)
# Canlıya geçince IYZICO_BASE_URL=https://api.iyzipay.com ve canlı anahtarlar.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Shopier (şirket gerekmez). Yönetim paneli > Ayarlar'dan da girilebilir; burada girilirse panel ayarı kullanılmaz.
# Shopier > Entegrasyonlar > Modül Yönetimi > Modül Ayarları: API kullanıcı / API şifre.
# Shopier bağlıysa ödemeler Shopier ile alınır.
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
# Geri dönüş adresinin Shopier'deki satır numarası (1-5)
SHOPIER_WEBSITE_INDEX=1

# İlk yönetici hesabı (kurulumda oluşturulur). Şifre en az 8 karakter.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-posta (SMTP). Örn. Gmail uygulama şifresi, Yandex, Resend SMTP, Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Motorcu Chopper <siparis@alanadiniz.com>"

# Vercel Cron'un günlük temizlik görevini doğrulamak için rastgele uzun bir metin.
CRON_SECRET=

# Örnek ürünleri yüklememek için false yapın (yalnızca ilk kurulumda etkilidir).
SEED_SAMPLE_PRODUCTS=true

# Mağaza ilk kurulumda ziyaretçilere açık başlar. Kapalı ("Yakında" sayfası) başlasın istersen true yapın.
STORE_START_CLOSED=false
